{
  "name": "webos-dock",
  "version": "1.0.1",
  "private": true,
  "description": "A cosy, animated home screen app for LG webOS TVs",
  "scripts": {
    "package": "ares-package home -o dist --no-minify",
    "install:tv": "ares-install --device tv dist/com.jaigeye.home_1.0.1_all.ipk",
    "launch:tv": "ares-launch --device tv com.jaigeye.home",
    "fetch-logos": "node tools/fetch-logos.js",
    "build-logos": "node tools/build-logos.js",
    "preview": "node tools/static-server.js home 5179"
  },
  "devDependencies": {
    "@webos-tools/cli": "3.2.6"
  },
  "license": "MIT"
}
